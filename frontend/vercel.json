{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/reconcile/:path*",
      "destination": "https://recon-agent-production-293e.up.railway.app/reconcile/:path*"
    },
    {
      "source": "/health",
      "destination": "https://recon-agent-production-293e.up.railway.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
